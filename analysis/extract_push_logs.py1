# cat ../push/k1/peer1/peer1_PUSH.log | grep -iE  "\-\-" | wc -l

import os 

curr_path = os.getcwd().removesuffix("/analysis") + "/push"
# print(curr_path)

for ks in os.listdir(curr_path):
    # print(ks)
    kpath=curr_path + "/" + ks 
    # print(kpath)
    for peer in os.listdir(kpath):
        
        ppath = kpath + "/" + peer
        logfile = f"{ppath}/{peer}_PUSH.log"
        try:
            with open(logfile, 'r') as file:
                count = 0
                for line in file:
                    # print(line)
                    if "11:03:14" in line:
                        break
                    if "---" in line:
                        count += 1
                        # break
                        print()
                    elif line.startswith("2025"):
                        linespl = line.split(",")
                        if len(linespl) <= 0:
                            continue
                            
                        news = ""
                        news = news + linespl[0]
                        for s in linespl[1:-1]:
                            ind = s.find(":")
                            if ind >= 0:
                                news = news + "," + s[ind+1:].strip()
                            else:
                                news = news + "," + ""
                        
                        print(news)
                        
                    elif line.startswith("Writing"):
                        
                        linespl = line.split("done.")
                            
                        # Extract size of objects
                        s0 = linespl[0]
                        ind1 = s0.find(",")
                        ind2 = s0.find("|")
                        objsize = s0[ind1+1:ind2].strip()

                        # Extract num objects and delta objects
                        s1 = linespl[1]
                        ind3 = s1.find("l")
                        ind4 = s1.find("(")
                        num_objs = s1[ind3+1:ind4].strip()
                        
                        ind6 = s1.find(")")
                        delta_objs = s1[ind4+6:ind6].strip()
                        
                        print(objsize, num_objs, delta_objs)
                        print(linespl)
                        if len(linespl) > 2:
                        
                            remote_str = linespl[2]
                            
                            find1s = "post-receive:"
                            find2s = "To"
                            
                            f1sind = remote_str.find(find1s)
                            f2sind = remote_str.find(find2s)
                            print("present")
                            rem_str_spl = remote_str[f1sind+len(find1s):f2sind].strip().split(",")
                            post_recv_arr = []
                            for rr in rem_str_spl:
                                # if rr.strip():
                                print(rr)
                            # print(rem_str_spl)
                            
                    elif "post-receive:" in line:
                        
                        linespl = line.split("done.")
                        remote_str = linespl[-1]
                            
                        find1s = "post-receive:"
                        find2s = "To"
                        
                        f1sind = remote_str.find(find1s)
                        f2sind = remote_str.find(find2s)
                        
                        rem_str_spl = remote_str[f1sind+len(find1s):f2sind].strip().split(",")
                        # print(rem_str_spl)
                        post_recv_arr = []
                        for rr in rem_str_spl:
                            if rr.strip():
                                print(rr)
                        
                        
                print(count)
        except Exception as e:
            print(f"An error occurred: {e}")
        break
    break